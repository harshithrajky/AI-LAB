
def unify(x, y, subst=None):
    if subst is None:
        subst = {}

    if x == y:
        return subst

    if x in subst:
        return unify(subst[x], y, subst)

    if y in subst:
        return unify(x, subst[y], subst)

    if isinstance(x, str) and x.islower():
        if occurs(x, y):
            return "FAILURE"
        subst[x] = y
        return subst

    if isinstance(y, str) and y.islower():
        if occurs(y, x):
            return "FAILURE"
        subst[y] = x
        return subst

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x) != len(y):
            return "FAILURE"

        for a, b in zip(x[1:], y[1:]):
            subst = unify(a, b, subst)
            if subst == "FAILURE":
                return "FAILURE"

        return subst

    return "FAILURE"


def occurs(var, expr):
    if var == expr:
        return True

    if isinstance(expr, tuple):
        return any(occurs(var, item) for item in expr[1:])

    return False


# Example from the PDF
expr1 = ("Eats", "x", "Apple")
expr2 = ("Eats", "Riya", "y")

result = unify(expr1, expr2)

if result == "FAILURE":
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution:", result)
